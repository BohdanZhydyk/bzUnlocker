{
  "name": "bz-unlocker",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k --names VITE,ELECTRON \"vite --host 127.0.0.1 --strictPort\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "predist:x86": "taskkill /F /IM bzUnlocker.exe /T 2>nul & exit /b 0",
    "dist:x86": "npm run build && electron-builder --win nsis --ia32 && node -e \"require('fs').renameSync('release/bzUnlocker-Setup-ia32.exe', 'release/bzUnlocker-Setup-x86.exe')\"",
    "predist:x64": "taskkill /F /IM bzUnlocker.exe /T 2>nul & exit /b 0",
    "dist:x64": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "lucide-react": "0.263.1"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "vite": "4.5.14",
    "@vitejs/plugin-react": "4.7.0",
    "sass": "1.69.7",
    "concurrently": "8.2.2",
    "wait-on": "7.2.0"
  },
  "build": {
    "appId": "local.bzunlocker.app",
    "productName": "bzUnlocker",
    "asar": true,
    "asarUnpack": [
      "native/**/*.ps1"
    ],
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "native/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "public/icon.ico",
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "artifactName": "bzUnlocker-Setup-${arch}.exe",
      "include": "installer.nsh"
    }
  }
}
